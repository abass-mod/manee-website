# GEMINI_API_KEY: Optional Gemini API key if AI features are later enabled.
GEMINI_API_KEY=""

# APP_URL: The public URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Admin initial credentials (if ADMIN_PASSWORD is left blank, a one-time setup form appears at /admin)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# JWT configuration (if blank in dev, an ephemeral 32-byte key is generated in memory)
JWT_ISSUER="InsulationPortfolio"
JWT_AUDIENCE="InsulationPortfolio.Admin"
JWT_SECRET=""
JWT_EXPIRY_MINUTES="480"

# Local storage settings
STORAGE_ROOT_PATH="./data/uploads"
STORAGE_MAX_FILE_SIZE_MB="8"
STORAGE_MAX_IMAGES_PER_PROJECT="40"

# SMTP email settings for async contact message notifications (optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_ADDRESS=""
SMTP_FROM_NAME="MANEE | مَنيع"
SMTP_USE_STARTTLS="true"

# Comma-separated allowed CORS origins in production
CORS_ALLOWED_ORIGINS=""
SWAGGER_ENABLED="true"
